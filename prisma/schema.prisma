generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String?
  documents Document[]
  createdAt DateTime   @default(now())
}




model Document {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  fileName  String
  rawText   String
  summary   String?
  riskFlags Json?
  createdAt DateTime @default(now())
}